<%
  const furos = resultado?.furos || [];
  const corda = Number(resultado?.corda || 0);
%>
<svg viewBox="0 0 800 500" role="img" aria-label="Desenho técnico de flange com furação" style="width:100%;max-width:860px;border:1px solid #e2e8f0;border-radius:14px;background:#fff;">
  <defs>
    <marker id="arrowFlange" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#0f172a" />
    </marker>
  </defs>

  <text x="50" y="40" font-size="22" font-weight="700" fill="#0f172a">Flange circular com furação uniforme</text>

  <circle cx="320" cy="250" r="170" fill="#f8fafc" stroke="#334155" stroke-width="2" />
  <circle cx="320" cy="250" r="95" fill="#fff" stroke="#334155" stroke-width="2" />

  <% furos.forEach((furo) => {
    const x = 320 + (furo.x || 0) * 0.75;
    const y = 250 + (furo.y || 0) * 0.75;
  %>
    <circle cx="<%= x %>" cy="<%= y %>" r="9" fill="#cbd5e1" stroke="#1e293b" stroke-width="1.3" />
  <% }) %>

  <% if (furos.length >= 2) {
    const x1 = 320 + (furos[0].x || 0) * 0.75;
    const y1 = 250 + (furos[0].y || 0) * 0.75;
    const x2 = 320 + (furos[1].x || 0) * 0.75;
    const y2 = 250 + (furos[1].y || 0) * 0.75;
  %>
    <line x1="<%= x1 %>" y1="<%= y1 %>" x2="<%= x2 %>" y2="<%= y2 %>" stroke="#dc2626" stroke-width="2" />
    <text x="510" y="190" font-size="16" fill="#991b1b">Corda = <%= corda.toFixed(2) %> mm</text>
    <line x1="480" y1="195" x2="430" y2="220" stroke="#991b1b" stroke-width="1.5" marker-end="url(#arrowFlange)" />
  <% } %>

  <line x1="120" y1="445" x2="520" y2="445" stroke="#0f172a" marker-start="url(#arrowFlange)" marker-end="url(#arrowFlange)" />
  <text x="245" y="470" font-size="15" fill="#0f172a">Distribuição angular constante entre furos</text>
</svg>
