<% layout('layout') %>
<style>
  .tr-page{display:grid;gap:14px}.tr-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px}
  .tr-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  @media(max-width:920px){.tr-grid{grid-template-columns:1fr}}
</style>

<div class="tr-page">
  <div style="display:flex;justify-content:space-between;align-items:center;"><h1>Furação de flange</h1><a class="btn" href="/tracagem">Voltar</a></div>

  <div class="tr-card">
    <form method="POST" action="/tracagem/furacao-flange/calcular" style="display:grid;gap:10px;">
      <div class="tr-grid">
        <div><label>D (diâmetro)</label><input class="input" name="D" type="number" step="0.01" required value="<%= calculo?.parametros?.D || '' %>"></div>
        <div><label>N (número de furos)</label><input class="input" name="N" type="number" step="1" required value="<%= calculo?.parametros?.N || calculo?.parametros?.furos || '' %>"></div>
      </div>
      <div><button class="btn btn-green" type="submit">CALCULAR</button></div>
    </form>
  </div>

  <% if (calculo?.resultado) { const entrada = calculo.resultado.entrada; const resultado = calculo.resultado.resultado; const observacoes = calculo.resultado.observacoes || []; %>
    <div class="tr-card"><%- include('partials/svg/flange-svg', { entrada, resultado }) %></div>
    <div class="tr-card">
      <h3>Planificação</h3>
      <p>Raio de furação: <b><%= resultado.raio.toFixed(2) %> mm</b></p>
      <p>Ângulo entre furos: <b><%= resultado.anguloEntreFuros.toFixed(2) %>°</b></p>
      <p>Corda: <b><%= resultado.corda.toFixed(2) %> mm</b></p>
    </div>
    <div class="tr-card">
      <h3>Resultados numéricos</h3>
      <ul>
        <li>N = <%= entrada.N %> furos</li>
        <li>Ângulo = <%= resultado.anguloEntreFuros.toFixed(2) %>°</li>
        <li>Corda = <%= resultado.corda.toFixed(2) %> mm</li>
      </ul>
      <h3>Observações técnicas</h3>
      <ul><% observacoes.forEach((obs)=> { %><li><%= obs %></li><% }) %></ul>
    </div>
  <% } %>
</div>
