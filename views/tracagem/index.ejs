<% layout('layout') %>

<style>
  .tr-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
  .tr-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px;box-shadow:0 1px 4px rgba(0,0,0,.04)}
  .tr-illu{height:110px;border:1px dashed #cbd5e1;border-radius:10px;display:flex;align-items:center;justify-content:center;background:#f8fafc;margin-bottom:10px}
</style>

<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
  <h1>Traçagem / Caldeiraria</h1>
  <a class="btn" href="/tracagem/lista">Histórico</a>
</div>

<div class="tr-grid" style="margin-top:10px;">
  <div class="tr-card"><div class="tr-illu">🌀 Rosca</div><h3>Rosca helicoidal</h3><a class="btn btn-green" href="/tracagem/rosca-helicoidal">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">⚙️ Flange</div><h3>Furação de flange</h3><a class="btn btn-green" href="/tracagem/furacao-flange">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">🛢️ Cilindro</div><h3>Cilindro</h3><a class="btn btn-green" href="/tracagem/cilindro">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">↪️ Curva</div><h3>Curva de gomos</h3><a class="btn btn-green" href="/tracagem/curva-gomos">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">⬛➡️⭕</div><h3>Quadrado para redondo</h3><a class="btn btn-green" href="/tracagem/quadrado-para-redondo">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">⭕↘️⭕</div><h3>Redução concêntrica</h3><a class="btn btn-green" href="/tracagem/reducao-concentrica">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">◐</div><h3>Semi-cilíndro</h3><a class="btn btn-green" href="/tracagem/semi-cilindro">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">🐟 Exc.</div><h3>Boca de lobo excêntrica</h3><a class="btn btn-green" href="/tracagem/boca-de-lobo-excentrica">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">🐟 45°</div><h3>Boca de lobo 45 graus</h3><a class="btn btn-green" href="/tracagem/boca-de-lobo-45-graus">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">🐟 90°</div><h3>Boca de lobo 90 graus</h3><a class="btn btn-green" href="/tracagem/boca-de-lobo-90-graus">Abrir</a></div>
  <div class="tr-card"><div class="tr-illu">🔩</div><h3>Mão francesa</h3><a class="btn btn-green" href="/tracagem/mao-francesa">Abrir</a></div>
</div>
