<% layout('layout') %>
<style>
  .tr-page{display:grid;gap:14px}.tr-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px}
  .tr-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  @media(max-width:920px){.tr-grid{grid-template-columns:1fr}}
</style>

<div class="tr-page">
  <div style="display:flex;justify-content:space-between;align-items:center;"><h1>Mão francesa</h1><a class="btn" href="/tracagem">Voltar</a></div>

  <div class="tr-card">
    <form method="POST" action="/tracagem/mao-francesa/calcular" style="display:grid;gap:10px;">
      <div class="tr-grid">
        <div><label>A (base)</label><input class="input" name="A" type="number" step="0.01" required value="<%= calculo?.parametros?.A || '' %>"></div>
        <div><label>h (altura)</label><input class="input" name="h" type="number" step="0.01" required value="<%= calculo?.parametros?.h || '' %>"></div>
        <div><label>E (espessura)</label><input class="input" name="E" type="number" step="0.01" required value="<%= calculo?.parametros?.E || '' %>"></div>
      </div>
      <div><button class="btn btn-green" type="submit">CALCULAR</button></div>
    </form>
  </div>

  <% if (calculo?.resultado) { const entrada = calculo.resultado.entrada; const resultado = calculo.resultado.resultado; const observacoes = calculo.resultado.observacoes || []; %>
    <div class="tr-card"><%- include('partials/svg/mao-francesa-svg', { entrada, resultado }) %></div>
    <div class="tr-card">
      <h3>Planificação</h3>
      <p>Comprimento diagonal C: <b><%= resultado.C.toFixed(2) %> mm</b></p>
      <p>Ângulo α: <b><%= resultado.alpha.toFixed(2) %>°</b></p>
    </div>
    <div class="tr-card">
      <h3>Resultados numéricos</h3>
      <ul>
        <li>A = <%= entrada.A.toFixed(2) %> mm</li>
        <li>h = <%= entrada.h.toFixed(2) %> mm</li>
        <li>E = <%= entrada.E.toFixed(2) %> mm</li>
        <li>C = <%= resultado.C.toFixed(2) %> mm</li>
      </ul>
      <h3>Observações técnicas</h3>
      <ul><% observacoes.forEach((obs)=> { %><li><%= obs %></li><% }) %></ul>
    </div>
  <% } %>
</div>
