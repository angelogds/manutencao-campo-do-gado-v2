<% layout('layout') %>
<style>
  .tr-page{display:grid;gap:14px}.tr-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px}
  .tr-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  @media(max-width:920px){.tr-grid{grid-template-columns:1fr}}
</style>

<div class="tr-page">
  <div style="display:flex;justify-content:space-between;align-items:center;"><h1>Rosca helicoidal</h1><a class="btn" href="/tracagem">Voltar</a></div>

  <div class="tr-card">
    <form method="POST" action="/tracagem/rosca-helicoidal/calcular" style="display:grid;gap:10px;">
      <div class="tr-grid">
        <div><label>D (diâmetro externo)</label><input class="input" name="D" type="number" step="0.01" required value="<%= calculo?.parametros?.D || '' %>"></div>
        <div><label>d (diâmetro interno)</label><input class="input" name="d" type="number" step="0.01" required value="<%= calculo?.parametros?.d || '' %>"></div>
        <div><label>P (passo)</label><input class="input" name="P" type="number" step="0.01" required value="<%= calculo?.parametros?.P || '' %>"></div>
      </div>
      <div><button class="btn btn-green" type="submit">CALCULAR</button></div>
    </form>
  </div>

  <% if (calculo?.resultado) { const entrada = calculo.resultado.entrada; const resultado = calculo.resultado.resultado; const observacoes = calculo.resultado.observacoes || []; %>
    <div class="tr-card"><%- include('partials/svg/rosca-svg', { entrada, resultado }) %></div>
    <div class="tr-card">
      <h3>Planificação</h3>
      <p>Circunferência média C: <b><%= resultado.C.toFixed(2) %> mm</b></p>
      <p>Comprimento T: <b><%= resultado.T.toFixed(2) %> mm</b></p>
    </div>
    <div class="tr-card">
      <h3>Resultados numéricos</h3>
      <ul>
        <li>R1 = <%= resultado.R1.toFixed(2) %> mm</li>
        <li>R2 = <%= resultado.R2.toFixed(2) %> mm</li>
        <li>C = <%= resultado.C.toFixed(2) %> mm</li>
        <li>T = <%= resultado.T.toFixed(2) %> mm</li>
      </ul>
      <h3>Observações técnicas</h3>
      <ul><% observacoes.forEach((obs)=> { %><li><%= obs %></li><% }) %></ul>
    </div>
  <% } %>
</div>
