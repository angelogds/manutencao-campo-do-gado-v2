<% layout('layout') %>
<style>
  .tr-page{display:grid;gap:14px}.tr-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px}
  .tr-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .img-tecnica{width:100%;max-width:640px;max-height:380px;display:block;margin:8px auto;border:1px solid #e2e8f0;border-radius:12px;background:#fff;object-fit:contain;padding:8px}
  .img-planificacao{max-width:520px;max-height:320px}.resultado{display:grid;gap:6px;font-size:1rem;line-height:1.35}
  @media(max-width:920px){.tr-grid{grid-template-columns:1fr}}
</style>
<div class="tr-page">
  <div style="display:flex;justify-content:space-between;align-items:center;"><h1>Boca de lobo 90°</h1><a class="btn" href="/tracagem">Voltar</a></div>
  <div class="tr-card"><form method="POST" action="/tracagem/boca-lobo-90/calcular" style="display:grid;gap:10px;">
    <div class="tr-grid">
      <div><label>D1 (tubo principal)</label><input class="input" name="D1" type="number" step="0.01" required value="<%= calculo?.parametros?.D1 || '' %>"></div>
      <div><label>D2 (tubo de ligação)</label><input class="input" name="D2" type="number" step="0.01" required value="<%= calculo?.parametros?.D2 || '' %>"></div>
    </div>
    <img src="/img/tracagem/planificacoes/boca-de-lobo-90-peca.png" class="img-tecnica" alt="Boca de lobo 90° - peça">
    <div><button class="btn btn-green" type="submit">CALCULAR</button></div>
  </form></div>
  <% if (calculo?.resultado) { const resultado = calculo.resultado.resultado; %>
    <div class="tr-card"><h3>Planificação</h3><img src="/img/tracagem/planificacoes/boca-de-lobo-90-planificacao.png" class="img-tecnica img-planificacao" alt="Boca de lobo 90° - planificação"></div>
    <div class="tr-card"><h3>Resultados</h3><div class="resultado">
      <div>R1 = <%= resultado.R1.toFixed(2) %> mm</div><div>R2 = <%= resultado.R2.toFixed(2) %> mm</div>
      <div>Desenvolvimento principal = <%= resultado.desenvolvimentoPrincipal.toFixed(2) %> mm</div>
      <div>Desenvolvimento secundário = <%= resultado.desenvolvimentoSecundario.toFixed(2) %> mm</div>
    </div></div>
  <% } %>
</div>
