<% layout('layout') %>
<style>
  .tr-page{display:grid;gap:14px}
  .tr-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px}
  .tr-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .tr-input{display:grid;gap:6px}
  .tr-input input{width:100%}
  @media(max-width:920px){.tr-grid{grid-template-columns:1fr}}
</style>

<div class="tr-page">
  <div style="display:flex;justify-content:space-between;align-items:center;">
    <h1>Cilindro</h1>
    <a class="btn" href="/tracagem">Voltar</a>
  </div>

  <div class="tr-card">
    <form method="POST" action="/tracagem/cilindro/calcular" style="display:grid;gap:10px;">
      <div class="tr-grid">
        <div class="tr-input"><label>D (diâmetro)</label><input class="input" name="D" type="number" step="0.01" required value="<%= calculo?.parametros?.D || '' %>"></div>
        <div class="tr-input"><label>h (altura)</label><input class="input" name="h" type="number" step="0.01" required value="<%= calculo?.parametros?.h || '' %>"></div>
        <div class="tr-input"><label>E (espessura)</label><input class="input" name="E" type="number" step="0.01" required value="<%= calculo?.parametros?.E || '' %>"></div>
      </div>
      <div><button class="btn btn-green" type="submit">CALCULAR</button></div>
    </form>
  </div>

  <% if (calculo?.resultado) { const entrada = calculo.resultado.entrada; const resultado = calculo.resultado.resultado; const observacoes = calculo.resultado.observacoes || []; %>
    <div class="tr-card">
      <%- include('partials/svg/cilindro-svg', { entrada, resultado }) %>
    </div>
    <div class="tr-card">
      <h3>Planificação</h3>
      <p>A (comprimento desenvolvido): <b><%= resultado.A.toFixed(2) %> mm</b></p>
      <p>B (altura): <b><%= resultado.B.toFixed(2) %> mm</b></p>
    </div>
    <div class="tr-card">
      <h3>Resultados numéricos</h3>
      <ul>
        <li>A = <%= resultado.A.toFixed(2) %> mm</li>
        <li>B = <%= resultado.B.toFixed(2) %> mm</li>
        <li>E = <%= entrada.E.toFixed(2) %> mm</li>
      </ul>
      <h3>Observações técnicas</h3>
      <ul>
        <% observacoes.forEach((obs)=> { %><li><%= obs %></li><% }) %>
      </ul>
    </div>
  <% } %>
</div>
