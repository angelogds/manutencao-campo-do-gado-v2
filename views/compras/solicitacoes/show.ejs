<% layout('layout') %>

<div class="page-head">
  <div>
    <h1><%= sol.numero || ('Solicitação #' + sol.id) %></h1>
    <p class="muted">Solicitante: <%= sol.solicitante_nome %> • Setor: <%= sol.setor_origem %> • Prioridade: <%= sol.prioridade %></p>
  </div>
  <div style="display:flex;gap:8px;">
    <a class="btn btn-ghost" href="/compras/solicitacoes?status=<%= sol.status %>">Voltar</a>
    <a class="btn btn-green" href="/compras/solicitacoes/<%= sol.id %>/pdf">Gerar PDF / Iniciar Cotação</a>
  </div>
</div>

<div class="card" style="margin-bottom:14px;">
  <% const pill = sol.status === 'ABERTA' ? 'pill-amber' : sol.status === 'EM_COTACAO' ? 'pill-sky' : 'pill-green'; %>
  <div style="display:flex;gap:20px;flex-wrap:wrap;align-items:center;">
    <div><span class="pill-tag <%= pill %>"><%= sol.status %></span></div>
    <div class="muted">Início cotação: <%= sol.cotacao_inicio_em ? fmtBR(sol.cotacao_inicio_em) : '-' %></div>
    <div class="muted">Comprada em: <%= sol.comprada_em ? fmtBR(sol.comprada_em) : '-' %></div>
  </div>
</div>

<% if (sol.status === 'EM_COTACAO') { %>
  <div class="card" style="margin-bottom:14px;">
    <div class="label" style="margin-bottom:8px;">Dados do fornecedor</div>
    <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/atualizar-dados" class="grid-3">
      <div><div class="label">Fornecedor</div><input class="input" name="fornecedor" value="<%= sol.fornecedor || '' %>" /></div>
      <div><div class="label">Previsão de entrega</div><input class="input" type="date" name="previsao_entrega" value="<%= sol.previsao_entrega ? String(sol.previsao_entrega).slice(0,10) : '' %>" /></div>
      <div><div class="label">Valor total</div><input class="input" name="valor_total" type="number" step="0.01" min="0" value="<%= sol.valor_total || '' %>" /></div>
      <div style="grid-column:1/-1;"><div class="label">Observações compras</div><textarea class="input" name="observacoes_compras"><%= sol.observacoes_compras || '' %></textarea></div>
      <div style="grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap;">
        <button class="btn btn-ghost" type="submit">Salvar dados do fornecedor</button>
      </div>
    </form>
    <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/marcar-comprada" style="margin-top:10px;">
      <button class="btn btn-green" type="submit">Marcar como Comprada</button>
    </form>
  </div>
<% } %>

<div class="card" style="margin-bottom:14px;">
  <div class="label">Anexos de Cotação</div>
  <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/anexos" enctype="multipart/form-data" style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
    <input class="input" type="file" name="arquivo" accept=".pdf,image/*" required />
    <button class="btn btn-green" type="submit">Enviar anexo</button>
  </form>
  <div class="table-wrap" style="margin-top:10px;">
    <table class="table">
      <thead><tr><th>Arquivo</th><th>Tipo</th><th>Tamanho</th><th>Enviado por</th><th>Data</th><th>Ações</th></tr></thead>
      <tbody>
        <% if (!sol.anexos || !sol.anexos.length) { %><tr><td colspan="6" class="muted">Sem anexos.</td></tr><% } %>
        <% (sol.anexos || []).forEach((anexo) => { %>
          <tr>
            <td><%= anexo.original_name || anexo.filename %></td>
            <td><%= anexo.mime_type || '-' %></td>
            <td><%= anexo.size ? Math.round(anexo.size / 1024) + ' KB' : '-' %></td>
            <td><%= anexo.uploaded_by_nome || '-' %></td>
            <td><%= anexo.uploaded_at ? fmtBR(anexo.uploaded_at) : '-' %></td>
            <td style="display:flex;gap:8px;">
              <a class="btn btn-sm btn-ghost" href="/compras/solicitacoes/<%= sol.id %>/anexos/<%= anexo.id %>/download">Baixar</a>
              <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/anexos/<%= anexo.id %>/delete" onsubmit="return confirm('Remover anexo?');"><button class="btn btn-sm" type="submit">Excluir</button></form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Item</th><th>Descrição</th><th>Unidade</th><th>Qtd Solicitada</th></tr></thead>
      <tbody>
        <% if (!sol.itens.length) { %><tr><td colspan="4" class="muted">Sem itens.</td></tr><% } %>
        <% sol.itens.forEach((item) => { %><tr><td><%= item.item_nome %></td><td><%= item.item_descricao || '-' %></td><td><%= item.unidade %></td><td><%= item.qtd_solicitada %></td></tr><% }) %>
      </tbody>
    </table>
  </div>
</div>
