<% layout('layout') %>

<div class="page-head">
  <div>
    <h1><%= sol.numero || ('Solicitação #' + sol.id) %></h1>
    <p class="muted">Solicitante: <%= sol.solicitante_nome %> • Setor: <%= sol.setor_origem %> • Prioridade: <%= sol.prioridade %></p>
  </div>
  <div style="display:flex;gap:8px;">
    <a class="btn btn-ghost" href="/compras/solicitacoes?status=<%= sol.status %>">Voltar</a>
    <a class="btn btn-green" href="/compras/solicitacoes/<%= sol.id %>/pdf">Gerar PDF</a>
  </div>
</div>

<div class="card" style="margin-bottom:12px;">
  <div class="grid-3">
    <div><div class="label">Status</div><span class="pill-tag pill-gray"><%= sol.status || '-' %></span></div>
    <div><div class="label">Abertura</div><strong><%= sol.created_at ? fmtBR(sol.created_at) : '-' %></strong></div>
    <div><div class="label">Início cotação</div><strong><%= sol.cotacao_inicio_em ? fmtBR(sol.cotacao_inicio_em) : '-' %></strong></div>
    <div><div class="label">Comprada em</div><strong><%= sol.comprada_em ? fmtBR(sol.comprada_em) : '-' %></strong></div>
    <div><div class="label">Previsão de entrega</div><strong><%= sol.previsao_entrega ? fmtBR(sol.previsao_entrega) : '-' %></strong></div>
    <div><div class="label">Fornecedor atual</div><strong><%= sol.fornecedor_nome || sol.fornecedor || '-' %></strong></div>
  </div>
</div>

<div class="card" style="margin-bottom:12px;">
  <div class="label">Itens da solicitação</div>
  <div class="table-wrap" style="margin-top:8px;">
    <table class="table">
      <thead><tr><th>Item</th><th>Descrição</th><th>Unidade</th><th>Qtd</th></tr></thead>
      <tbody>
        <% if (!sol.itens?.length) { %><tr><td colspan="4" class="muted">Sem itens.</td></tr><% } %>
        <% (sol.itens || []).forEach((item) => { %>
          <tr>
            <td><%= item.item_nome || '-' %></td>
            <td><%= item.item_descricao || '-' %></td>
            <td><%= item.unidade || '-' %></td>
            <td><%= item.qtd_solicitada || 0 %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card" style="margin-bottom:12px;">
  <div class="label" style="margin-bottom:8px;">Cotações (múltiplos fornecedores)</div>
  <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/cotacoes" class="grid-3" style="margin-bottom:12px;">
    <div>
      <div class="label">Fornecedor cadastrado</div>
      <select class="input" name="fornecedor_id" onchange="document.getElementById('fornecedor_nome_fallback').value=this.options[this.selectedIndex].dataset.nome || ''">
        <option value="">Selecionar</option>
        <% (fornecedores || []).forEach((f) => { %>
          <option value="<%= f.id %>" data-nome="<%= f.nome %>"><%= f.nome %><%= f.cnpj ? (' • ' + f.cnpj) : '' %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <div class="label">Fornecedor (fallback)</div>
      <input id="fornecedor_nome_fallback" class="input" name="fornecedor_nome" placeholder="Preenchido automaticamente" />
    </div>
    <div>
      <div class="label">Valor total da cotação</div>
      <input class="input" type="number" min="0" step="0.01" name="valor_total" />
    </div>
    <div>
      <div class="label">Prazo de entrega</div>
      <input class="input" type="date" name="prazo_entrega" />
    </div>
    <div style="grid-column: span 2;">
      <div class="label">Observação</div>
      <input class="input" name="observacao" placeholder="Condições comerciais, frete, etc." />
    </div>
    <div style="grid-column:1/-1;">
      <button class="btn btn-green" type="submit">Adicionar cotação</button>
    </div>
  </form>

  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Fornecedor</th><th>Valor</th><th>Prazo</th><th>Obs</th><th>Selecionada</th><th>Ação</th></tr></thead>
      <tbody>
        <% if (!sol.cotacoes?.length) { %><tr><td colspan="6" class="muted">Sem cotações cadastradas.</td></tr><% } %>
        <% (sol.cotacoes || []).forEach((c) => { %>
          <tr>
            <td><%= c.fornecedor_cadastro_nome || c.fornecedor_nome || '-' %></td>
            <td><%= c.valor_total != null ? Number(c.valor_total).toFixed(2) : '-' %></td>
            <td><%= c.prazo_entrega ? fmtBR(c.prazo_entrega) : '-' %></td>
            <td><%= c.observacao || '-' %></td>
            <td><%= Number(c.selecionada) === 1 ? '✅ Sim' : 'Não' %></td>
            <td>
              <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/cotacoes/<%= c.id %>/selecionar">
                <button class="btn btn-sm <%= Number(c.selecionada) === 1 ? 'btn-ghost' : '' %>" type="submit"><%= Number(c.selecionada) === 1 ? 'Selecionada' : 'Selecionar' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card" style="margin-bottom:12px;">
  <div class="label" style="margin-bottom:8px;">Anexos de cotação</div>
  <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/anexos" enctype="multipart/form-data" class="grid-3" style="margin-bottom:12px;">
    <div>
      <div class="label">Tipo</div>
      <select class="input" name="tipo">
        <option value="COTACAO">Cotação</option>
        <option value="NF">Nota Fiscal</option>
        <option value="FOTO">Foto</option>
      </select>
    </div>
    <div style="grid-column: span 2;">
      <div class="label">Arquivo (PDF/JPG/PNG/WEBP)</div>
      <input class="input" type="file" name="arquivo" required />
    </div>
    <div style="grid-column:1/-1;"><button class="btn" type="submit">Enviar anexo</button></div>
  </form>

  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Tipo</th><th>Arquivo</th><th>Enviado por</th><th>Data</th><th>Ações</th></tr></thead>
      <tbody>
        <% if (!sol.anexos?.length) { %><tr><td colspan="5" class="muted">Sem anexos.</td></tr><% } %>
        <% (sol.anexos || []).forEach((a) => { %>
          <tr>
            <td><%= a.tipo || '-' %></td>
            <td><%= a.original_name || a.filename %></td>
            <td><%= a.uploaded_by_nome || '-' %></td>
            <td><%= a.uploaded_at ? fmtBR(a.uploaded_at) : '-' %></td>
            <td style="display:flex;gap:6px;">
              <a class="btn btn-sm btn-ghost" href="/compras/anexos/<%= a.id %>/download">Baixar</a>
              <form method="POST" action="/compras/anexos/<%= a.id %>/delete"><button class="btn btn-sm" type="submit">Excluir</button></form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card" style="margin-bottom:12px;">
  <div class="label" style="margin-bottom:8px;">Atualização de dados da compra</div>
  <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/atualizar-dados" class="grid-3">
    <div>
      <div class="label">Fornecedor</div>
      <input class="input" name="fornecedor" value="<%= sol.fornecedor || '' %>" />
    </div>
    <div>
      <div class="label">Previsão de entrega</div>
      <input class="input" type="date" name="previsao_entrega" value="<%= sol.previsao_entrega ? String(sol.previsao_entrega).slice(0,10) : '' %>" />
    </div>
    <div>
      <div class="label">Valor total</div>
      <input class="input" type="number" step="0.01" min="0" name="valor_total" value="<%= sol.valor_total || '' %>" />
    </div>
    <div style="grid-column:1/-1;">
      <div class="label">Observações</div>
      <textarea class="input" name="observacoes_compras"><%= sol.observacoes_compras || '' %></textarea>
    </div>
    <div style="grid-column:1/-1;display:flex;gap:8px;">
      <button class="btn btn-ghost" type="submit">Salvar dados</button>
    </div>
  </form>
  <% if (sol.status === 'EM_COTACAO') { %>
    <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/marcar-comprada" style="margin-top:8px;">
      <button class="btn btn-green" type="submit">Marcar como COMPRADA</button>
    </form>
  <% } %>
</div>

<div class="card">
  <div class="label" style="margin-bottom:8px;">Histórico de preço (últimos 5)</div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Item</th><th>Fornecedor</th><th>Preço Unit.</th><th>Preço Total</th><th>Data</th></tr></thead>
      <tbody>
        <% if (!sol.historicoPrecos?.length) { %><tr><td colspan="5" class="muted">Sem histórico para exibir.</td></tr><% } %>
        <% (sol.historicoPrecos || []).forEach((h) => { %>
          <tr>
            <td><%= h.item_nome || '-' %></td>
            <td><%= h.fornecedor_cadastro_nome || h.fornecedor_nome || '-' %></td>
            <td><%= h.preco_unit != null ? Number(h.preco_unit).toFixed(2) : '-' %></td>
            <td><%= h.preco_total != null ? Number(h.preco_total).toFixed(2) : '-' %></td>
            <td><%= h.data_compra ? fmtBR(h.data_compra) : '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
