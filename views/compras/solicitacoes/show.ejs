<% layout('layout') %>

<div class="page-head">
  <div>
    <h1><%= sol.numero || ('Solicitação #' + sol.id) %></h1>
    <p class="muted">Solicitante: <%= sol.solicitante_nome %> • Setor: <%= sol.setor_origem %> • Status: <%= sol.status %></p>
  </div>
  <div style="display:flex;gap:8px;">
    <a class="btn btn-ghost" href="/compras/solicitacoes?status=<%= sol.status %>">Voltar</a>
    <a class="btn btn-green" href="/compras/solicitacoes/<%= sol.id %>/pdf">Baixar PDF</a>
  </div>
</div>

<div class="card" style="margin-bottom:14px;">
  <div class="label" style="margin-bottom:8px;">Dados de cotação/compra</div>
  <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/atualizar-dados" class="grid-3">
    <div>
      <div class="label">Fornecedor (cadastro)</div>
      <select class="input" name="fornecedor_id" onchange="const opt=this.options[this.selectedIndex]; document.getElementById('fornecedor_nome').value = opt.dataset.nome || '';">
        <option value="">Selecionar fornecedor</option>
        <% (fornecedores || []).forEach((f) => { %>
          <option value="<%= f.id %>" data-nome="<%= f.nome %>" <%= Number(sol.fornecedor_id || 0) === Number(f.id) ? 'selected' : '' %>>
            <%= f.nome %><%= f.cnpj ? (' • ' + f.cnpj) : '' %><%= f.cidade ? (' • ' + f.cidade) : '' %>
          </option>
        <% }) %>
      </select>
      <div class="muted" style="margin-top:4px;">Dica: gerencie cadastros em <a href="/fornecedores">/fornecedores</a>.</div>
    </div>
    <div>
      <div class="label">Fornecedor (texto livre)</div>
      <input id="fornecedor_nome" class="input" name="fornecedor" value="<%= sol.fornecedor || sol.fornecedor_nome || '' %>" placeholder="Preenchido automaticamente ao selecionar" />
    </div>
    <div><div class="label">Previsão de entrega</div><input class="input" type="date" name="previsao_entrega" value="<%= sol.previsao_entrega ? String(sol.previsao_entrega).slice(0,10) : '' %>" /></div>
    <div><div class="label">Valor total</div><input class="input" name="valor_total" type="number" step="0.01" min="0" value="<%= sol.valor_total || '' %>" /></div>
    <div style="grid-column:1/-1;"><div class="label">Observações compras</div><textarea class="input" name="observacoes_compras"><%= sol.observacoes_compras || '' %></textarea></div>
    <div style="grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap;">
      <button class="btn btn-ghost" type="submit">Salvar dados</button>
    </div>
  </form>
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;">
    <% if (sol.status === 'ABERTA') { %>
      <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/assumir"><button class="btn btn-green" type="submit">Assumir (EM_COTACAO)</button></form>
    <% } %>
    <% if (sol.status === 'EM_COTACAO') { %>
      <form method="POST" action="/compras/solicitacoes/<%= sol.id %>/marcar-comprada"><button class="btn btn-green" type="submit">Marcar COMPRADA</button></form>
    <% } %>
  </div>
</div>


<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Item</th><th>Descrição</th><th>Unidade</th><th>Qtd Solicitada</th><th>Status item</th></tr></thead>
      <tbody>
        <% if (!sol.itens.length) { %><tr><td colspan="5" class="muted">Sem itens.</td></tr><% } %>
        <% sol.itens.forEach((item) => { %>
          <tr>
            <td><%= item.item_nome %></td>
            <td><%= item.item_descricao || '-' %></td>
            <td><%= item.unidade %></td>
            <td><%= item.qtd_solicitada %></td>
            <td><%= item.status_item || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
