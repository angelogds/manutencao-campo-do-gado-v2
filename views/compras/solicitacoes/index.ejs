<% layout('layout') %>

<div class="page-head">
  <div>
    <h1>Compras</h1>
    <p class="muted">Gestão de solicitações por status do fluxo de cotação e compra.</p>
  </div>
  <div>
    <a class="btn btn-green" href="/solicitacoes/nova">+ Nova Solicitação</a>
  </div>
</div>

<div class="subtabs" style="margin-top:0;">
  <a class="subtab <%= status === 'ABERTA' ? 'active' : '' %>" href="/compras/solicitacoes?status=ABERTA">Abertas</a>
  <a class="subtab <%= status === 'EM_COTACAO' ? 'active' : '' %>" href="/compras/solicitacoes?status=EM_COTACAO">Em cotação</a>
  <a class="subtab <%= status === 'COMPRADA' ? 'active' : '' %>" href="/compras/solicitacoes?status=COMPRADA">Compradas</a>
</div>

<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Número</th>
          <th>Status</th>
          <th>Solicitante</th>
          <th>Setor</th>
          <th>Criada em</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (!lista.length) { %>
          <tr><td colspan="6" class="muted" style="text-align:center;">Nenhuma solicitação nesta aba.</td></tr>
        <% } %>
        <% lista.forEach((s) => { 
          const pill = s.status === 'ABERTA' ? 'pill-amber' : s.status === 'EM_COTACAO' ? 'pill-sky' : s.status === 'COMPRADA' ? 'pill-green' : 'pill-gray';
        %>
          <tr>
            <td><strong><%= s.numero || ('#' + s.id) %></strong></td>
            <td><span class="pill-tag <%= pill %>"><%= s.status %></span></td>
            <td><%= s.solicitante_nome || '-' %></td>
            <td><%= s.setor_origem || '-' %></td>
            <td><%= s.created_at ? fmtBR(s.created_at) : '-' %></td>
            <td><a class="btn btn-sm btn-ghost" href="/compras/solicitacoes/<%= s.id %>">Abrir</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
