<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Login • Campo do Gado</title>
  <style>
    :root {
      --overlay-dark: rgba(7, 12, 18, 0.72);
      --overlay-soft: rgba(7, 12, 18, 0.38);
      --card-bg: rgba(255, 255, 255, 0.08);
      --card-border: rgba(255, 255, 255, 0.16);
      --card-radius: 22px;
      --card-width: 350px;
      --card-padding: 20px;
      --txt-strong: #f8fafc;
      --txt-soft: rgba(241, 245, 249, 0.75);
      --brand-green: #2f8d57;
      --brand-green-dark: #1f6a40;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      overflow: hidden;
      background: #0a0a0a;
      color: var(--txt-strong);
    }

    .hero-container {
      position: fixed;
      inset: 0;
      z-index: 1;
    }

    .scene {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: scale(1.1);
      transition: opacity 1.8s ease, transform 1.8s ease;
      overflow: hidden;
    }

    .scene.active {
      opacity: 1;
      transform: scale(1);
    }

    .scene img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.72) contrast(1.08) saturate(0.94);
    }

    .scene.active img {
      animation: slowZoom 18s ease-in-out infinite alternate;
    }

    @keyframes slowZoom {
      0% { transform: scale(1) translate(0, 0); }
      100% { transform: scale(1.06) translate(-1%, -1%); }
    }

    .industrial-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        140deg,
        var(--overlay-dark) 0%,
        rgba(10, 22, 34, 0.55) 45%,
        var(--overlay-soft) 70%,
        rgba(5, 10, 15, 0.82) 100%
      );
      z-index: 3;
      pointer-events: none;
    }

    .vignette {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, transparent 0%, rgba(0, 0, 0, 0.5) 100%);
      z-index: 4;
      pointer-events: none;
    }

    .tech-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(74, 139, 95, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(74, 139, 95, 0.05) 1px, transparent 1px);
      background-size: 55px 55px;
      z-index: 5;
      pointer-events: none;
    }

    .login-screen {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 28px 8vw;
      z-index: 20;
    }

    .login-card {
      width: min(var(--card-width), 100%);
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--card-radius);
      box-shadow: 0 20px 40px rgba(2, 6, 23, 0.44);
      padding: var(--card-padding);
      backdrop-filter: blur(14px);
    }

    .login-logo-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      margin-bottom: 14px;
    }

    .login-logo {
      width: min(170px, 82%);
      height: auto;
      object-fit: contain;
      display: block;
    }

    .company-name {
      color: #fff;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .login-subtitle {
      margin: 0 0 14px;
      color: var(--txt-soft);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-align: center;
      text-transform: uppercase;
    }

    .login-form { display: grid; gap: 10px; }
    .field { display: grid; gap: 5px; }

    .field label {
      color: #f1f5f9;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .field input {
      width: 100%;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 14px;
      color: #fff;
      background: rgba(15, 23, 42, 0.4);
    }

    .field input::placeholder { color: rgba(255, 255, 255, 0.48); }

    .field input:focus {
      outline: none;
      border-color: #6ab88a;
      box-shadow: 0 0 0 3px rgba(74, 139, 95, 0.2);
    }

    .btn-login {
      margin-top: 6px;
      width: 100%;
      border: none;
      border-radius: 10px;
      padding: 12px;
      background: linear-gradient(135deg, var(--brand-green-dark) 0%, var(--brand-green) 100%);
      color: #fff;
      font-size: 14px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      cursor: pointer;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .btn-login:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 25px rgba(45, 90, 61, 0.4);
    }

    .alert {
      margin: 0 0 10px;
      padding: 9px 11px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 700;
    }

    .alert-error { background: rgba(127, 29, 29, 0.72); color: #fee2e2; }
    .alert-success { background: rgba(22, 101, 52, 0.7); color: #dcfce7; }
    .alert-info { background: rgba(7, 89, 133, 0.7); color: #e0f2fe; }

    .animation-status {
      position: fixed;
      left: 28px;
      bottom: 22px;
      z-index: 12;
      color: rgba(255, 255, 255, 0.74);
      font-size: 11px;
      letter-spacing: 1.8px;
      text-transform: uppercase;
    }

    .stage-indicator {
      color: #6ab88a;
      font-weight: 700;
    }

    @media (max-width: 900px) {
      :root {
        --card-width: 330px;
        --card-padding: 18px;
      }

      .login-screen {
        justify-content: center;
        padding: 20px;
      }

      .animation-status {
        left: 16px;
        bottom: 14px;
      }
    }

    @media (max-width: 640px) {
      :root {
        --card-width: 92vw;
      }

      .company-name {
        font-size: 20px;
      }

      .animation-status {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="hero-container" id="heroContainer">
    <div class="scene active"><img src="/IMG/campo-do-bg-gado-login.svg.jpeg" alt="Equipe Campo do Gado em manutenção" /></div>
    <div class="industrial-overlay"></div>
    <div class="vignette"></div>
    <div class="tech-grid"></div>
  </div>

  <div class="animation-status">
    Fase: <span class="stage-indicator" id="stageText">Montagem</span>
  </div>

  <section class="login-screen">
    <div class="login-card">
      <div class="login-logo-wrap">
        <img class="login-logo" src="/IMG/login_campo_do_gado.png.png.png" alt="Logo manutenção Campo do Gado" />
        <h1 class="company-name">Campo do Gado</h1>
      </div>
      <p class="login-subtitle">Sistema de Manutenção Industrial</p>

      <% if (flash && flash.error && flash.error.length) { %>
        <div class="alert alert-error"><%= flash.error[0] %></div>
      <% } %>

      <% if (flash && flash.success && flash.success.length) { %>
        <div class="alert alert-success"><%= flash.success[0] %></div>
      <% } %>

      <% if (lockout) { %>
        <div class="alert alert-error">
          Muitas tentativas. Aguarde <b><%= lockout.remainingSeconds %></b> segundos e tente novamente.
        </div>
      <% } %>

      <% if (attemptsLeft !== null && attemptsLeft !== undefined) { %>
        <div class="alert alert-info">
          Tentativas restantes: <b><%= attemptsLeft %></b>
        </div>
      <% } %>

      <form class="login-form" action="/auth/login" method="POST">
        <input type="hidden" name="next" value="<%= next || '' %>" />

        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            type="email"
            name="email"
            value="<%= rememberedEmail || '' %>"
            required
            autocomplete="email"
            placeholder="seuemail@campodogado.local"
          />
        </div>

        <div class="field">
          <label for="password">Senha</label>
          <input
            id="password"
            type="password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="Digite sua senha"
          />
        </div>

        <button class="btn-login" type="submit">Entrar no sistema</button>
      </form>
    </div>
  </section>

  <script>
    const heroContainer = document.getElementById('heroContainer');
    const stageText = document.getElementById('stageText');
    const stageNames = ['Montagem', 'Usinagem', 'Campo', 'Logística', 'Caldeiraria', 'Operação'];
    const stageDuration = 5000;

    // Pasta padrão para você enviar os binários no ChatHub:
    // public/img/slideshow-login/
    // Padrões aceitos: slide-01.jpg, slide-02.jpeg, slide-03.png, ...
    const SLIDE_BASE_DIR = '/img/slideshow-login';
    const candidateFiles = [];
    for (let i = 1; i <= 30; i += 1) {
      const index = String(i).padStart(2, '0');
      candidateFiles.push(`${SLIDE_BASE_DIR}/slide-${index}.jpg`);
      candidateFiles.push(`${SLIDE_BASE_DIR}/slide-${index}.jpeg`);
      candidateFiles.push(`${SLIDE_BASE_DIR}/slide-${index}.png`);
      candidateFiles.push(`${SLIDE_BASE_DIR}/slide-${index}.webp`);
    }

    function imageExists(src) {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve(src);
        img.onerror = () => resolve(null);
        img.src = src;
      });
    }

    function createScene(src, isActive = false) {
      const scene = document.createElement('div');
      scene.className = `scene${isActive ? ' active' : ''}`;
      const img = document.createElement('img');
      img.src = src;
      img.alt = 'Imagem real de manutenção Campo do Gado';
      scene.appendChild(img);
      return scene;
    }

    async function discoverSlides() {
      const result = await Promise.all(candidateFiles.map((file) => imageExists(file)));
      const loaded = result.filter(Boolean);
      return [...new Set(loaded)];
    }

    function mountSlides(slides) {
      const overlays = heroContainer.querySelectorAll('.industrial-overlay, .vignette, .tech-grid');
      heroContainer.querySelectorAll('.scene').forEach((node) => node.remove());

      const sources = slides.length ? slides : ['/IMG/campo-do-bg-gado-login.svg.jpeg'];
      sources.forEach((src, index) => {
        heroContainer.insertBefore(createScene(src, index === 0), overlays[0]);
      });

      return heroContainer.querySelectorAll('.scene');
    }

    function startAnimation(scenes) {
      let currentStage = 0;

      function updateStage(index) {
        scenes.forEach((scene) => scene.classList.remove('active'));
        scenes[index].classList.add('active');
        stageText.style.opacity = 0;
        setTimeout(() => {
          stageText.textContent = stageNames[index % stageNames.length];
          stageText.style.opacity = 1;
        }, 120);
      }

      function nextStage() {
        currentStage = (currentStage + 1) % scenes.length;
        updateStage(currentStage);
      }

      stageText.style.transition = 'opacity 0.4s ease';
      setInterval(nextStage, stageDuration);
    }

    (async () => {
      const slides = await discoverSlides();
      const scenes = mountSlides(slides);
      startAnimation(scenes);
    })();
  </script>
</body>
</html>
