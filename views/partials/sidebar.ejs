<!-- views/parciais/sidebar.ejs -->
<%
  // NÃO usar require aqui.
  // canAccessModule e normalizeRole vêm do server.js via app.locals/res.locals

  const getRoleValue = () => {
    return (user?.funcao || user?.Função || user?.role || user?.perfil || user?.cargo || '').toString();
  };

  const role = (typeof normalizeRole === 'function')
    ? normalizeRole(getRoleValue())
    : getRoleValue();

  const can = (mod) => {
    if (typeof canAccessModule !== 'function') return true; // fallback: não quebra layout
    try { return canAccessModule(role, mod); } catch (_e) { return true; }
  };

  const canPainel   = can('painel_operacional');
  const canOS       = can('os');
  const canPCM      = can('pcm');
  const canPrevent  = can('preventivas');
  const canEstoque  = can('estoque');
  const canCompras  = can('compras');
  const canEscala   = can('escala');
  const canMotores  = can('motores');
  const canUsers    = can('usuarios');
  const canDemandas = can('demandas');
%>

<aside class="sidebar">
  <div class="sidebar-brand">
    <a href="/" class="brand">
      <img src="/img/logo_menu_256.png" alt="Campo do Gado" style="height:40px;">
      <div class="brand-text">
        <div class="brand-title">Manutenção</div>
        <div class="brand-sub">Campo do Gado</div>
      </div>
    </a>
  </div>

  <nav class="sidebar-nav">
    <ul>
      <% if (canPainel) { %>
        <li class="<%= (activeMenu === 'dashboard' || activeMenu === 'painel') ? 'active' : '' %>">
          <a href="/dashboard">Painel Operacional</a>
        </li>
      <% } %>

      <% if (canOS) { %>
        <li class="<%= activeMenu === 'os' ? 'active' : '' %>">
          <a href="/os">Ordens de Serviço</a>
        </li>
      <% } %>

      <% if (canDemandas) { %>
        <li class="<%= activeMenu === 'demandas' ? 'active' : '' %>">
          <a href="/demandas">Demandas</a>
        </li>
      <% } %>

      <% if (canPCM) { %>
        <li class="<%= activeMenu === 'pcm' ? 'active' : '' %>">
          <a href="/pcm">PCM</a>
        </li>
      <% } %>

      <% if (canPrevent) { %>
        <li class="<%= activeMenu === 'preventivas' ? 'active' : '' %>">
          <a href="/preventivas">Preventivas</a>
        </li>
      <% } %>

      <% if (canEstoque) { %>
        <li class="<%= activeMenu === 'estoque' ? 'active' : '' %>">
          <a href="/estoque">Estoque</a>
        </li>
      <% } %>

      <% if (canCompras) { %>
        <li class="<%= activeMenu === 'compras' ? 'active' : '' %>">
          <a href="/compras">Compras</a>
        </li>
      <% } %>

      <% if (canEscala) { %>
        <li class="<%= activeMenu === 'escala' ? 'active' : '' %>">
          <a href="/escala">Escala</a>
        </li>
      <% } %>

      <% if (canMotores) { %>
        <li class="<%= activeMenu === 'motores' ? 'active' : '' %>">
          <a href="/motores">Motores</a>
        </li>
      <% } %>

      <% if (canUsers) { %>
        <li class="<%= activeMenu === 'usuarios' ? 'active' : '' %>">
          <a href="/usuarios">Usuários</a>
        </li>
      <% } %>
    </ul>
  </nav>

  <div class="sidebar-footer">
    <div class="user-box">
      <div class="user-name"><%= user?.nome || 'Usuário' %></div>
      <div class="user-role"><%= role || '-' %></div>
    </div>
  </div>
</aside>
