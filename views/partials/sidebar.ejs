<%
  const menu = String(activeMenu || "");
  const can = typeof canAccessModule === "function" ? canAccessModule : (() => true);
%>

<aside class="sidebar">
  <div class="brand">
    <div class="brand-badge">CG</div>
    <div>
      <div class="brand-title">Campo do Gado</div>
      <div class="brand-sub">Manutenção • V2</div>
    </div>
  </div>

  <nav class="nav">
    <% if (can("dashboard")) { %>
      <a class="nav-item <%= menu==='dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a>
    <% } %>

    <% if (can("os")) { %>
      <a class="nav-item <%= menu==='os' ? 'active' : '' %>" href="/os">Ordens de Serviço</a>
    <% } %>

    <% if (can("equipamentos")) { %>
      <a class="nav-item <%= menu==='equipamentos' ? 'active' : '' %>" href="/equipamentos">Equipamentos</a>
    <% } %>

    <% if (can("preventivas")) { %>
      <a class="nav-item <%= menu==='preventivas' ? 'active' : '' %>" href="/preventivas">Preventivas</a>
    <% } %>

    <div class="nav-divider"></div>
    <div class="nav-section">Materiais</div>

    <% if (can("estoque")) { %>
      <a class="nav-item <%= menu==='estoque' ? 'active' : '' %>" href="/estoque">Estoque</a>
    <% } %>

    <% if (can("solicitacoes")) { %>
      <a class="nav-item <%= menu==='solicitacoes' ? 'active' : '' %>" href="/solicitacoes">Solicitações</a>
    <% } %>

    <% if (can("compras")) { %>
      <a class="nav-item <%= menu==='compras' ? 'active' : '' %>" href="/compras">Compras</a>
    <% } %>

    <div class="nav-divider"></div>

    <% if (can("escala")) { %>
      <a class="nav-item <%= menu==='escala' ? 'active' : '' %>" href="/escala">Escala</a>
    <% } %>

    <% if (can("avisos")) { %>
      <a class="nav-item <%= menu==='avisos' ? 'active' : '' %>" href="/avisos">Mural</a>
    <% } %>

    <% if (can("motores")) { %>
      <a class="nav-item <%= menu==='motores' ? 'active' : '' %>" href="/motores">Motores</a>
    <% } %>

    <% if (can("demandas")) { %>
      <a class="nav-item <%= menu==='demandas' ? 'active' : '' %>" href="/demandas">Demandas</a>
    <% } %>

    <% if (can("usuarios")) { %>
      <a class="nav-item <%= menu==='usuarios' ? 'active' : '' %>" href="/usuarios">Usuários</a>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <div>Unidade Reciclagem</div>
  </div>
</aside>
