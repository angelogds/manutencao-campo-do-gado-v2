<% layout('layout') %>

<style>
  .page-head{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:12px;
    margin-bottom:14px;
  }
  .muted{ font-size:13px; color:#6b7280; margin-top:6px; }

  .card{
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:16px;
    padding:18px;
  }

  .actions{
    display:flex;
    gap:10px;
    align-items:center;
  }

  /* ✅ MESMO botão do Equipamentos (mesma cor + mesmo formato) */
  .btn-primary{
    background:#16a34a;
    color:#fff;
    border:none;
    padding:10px 16px;
    border-radius:10px;
    font-weight:700;
    cursor:pointer;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    gap:8px;
  }
  .btn-primary:hover{ background:#15803d; }

  /* Pílulas (mais leves e bonitas) */
  .pill{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:4px 10px;
    border-radius:999px;
    font-weight:800;
    font-size:12px;
    border:1px solid #e5e7eb;
    background:#f8fafc;
    color:#0f172a;
    white-space:nowrap;
  }
  .pill-green{ background:#ecfdf5; border-color:#bbf7d0; color:#14532d; }
  .pill-gray{  background:#f1f5f9; border-color:#e2e8f0; color:#334155; }
  .pill-blue{  background:#eff6ff; border-color:#bfdbfe; color:#1d4ed8; }

  /* Botão pequeno (Ações) igual Equipamentos */
  .btn-sm{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:8px 12px;
    border-radius:10px;
    border:1px solid #d1d5db;
    background:#fff;
    cursor:pointer;
    text-decoration:none;
    font-weight:800;
    color:#0f172a;
    white-space:nowrap;
  }
  .btn-sm:hover{
    border-color: rgba(22,163,74,.45);
    background:#ecfdf5;
  }

  .preventiva-list{
    display:none;
    gap:12px;
  }
  .preventiva-card{
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:14px;
    background:#fff;
  }
  .preventiva-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:8px;
  }
  .preventiva-id{
    font-size:26px;
    font-weight:800;
    line-height:1;
    text-decoration:none;
    color:#0f172a;
  }
  .preventiva-title{
    font-size:20px;
    line-height:1.25;
    margin:4px 0 8px;
  }
  .preventiva-equip{
    color:#6b7280;
    font-size:15px;
    margin-bottom:10px;
  }
  .preventiva-meta{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    padding-top:10px;
    border-top:1px solid #eef2f7;
  }

  @media (max-width: 900px){
    .table-wrap{ display:none; }
    .preventiva-list{ display:grid; }
    .card{ padding:12px; }
    .page-head{
      flex-wrap:wrap;
      align-items:flex-start;
    }
    .actions{
      width:100%;
    }
    .btn-primary{
      width:100%;
      justify-content:center;
    }
    .preventiva-title{ font-size:18px; }
    .preventiva-id{ font-size:24px; }
  }
</style>

<div class="page-head">
  <div>
    <h1>Preventivas</h1>
    <div class="muted">Planos de manutenção preventiva.</div>
  </div>

  <div class="actions">
    <a class="btn-primary" href="/preventivas/nova">+ Nova Preventiva</a>
  </div>
</div>

<div class="card">
  <div class="preventiva-list">
    <% if (!lista || !lista.length) { %>
      <div class="preventiva-card" style="text-align:center; color:#6b7280;">
        Nenhuma preventiva cadastrada.
      </div>
    <% } %>

    <% (lista || []).forEach(p => { %>
      <% const statusExec = String(p.execucao_status || "").toLowerCase(); %>
      <% const statusAberta = !statusExec || statusExec === "pendente" || statusExec === "atrasada"; %>
      <% const statusLabel = statusAberta ? "ABERTA" : "FECHADA"; %>
      <% const statusClass = statusAberta ? "pill-open" : "pill-closed"; %>
      <% const equipamentoLabel = p.equipamento_nome
            ? (p.equipamento_codigo
                ? (p.equipamento_codigo + " • " + p.equipamento_nome)
                : p.equipamento_nome)
            : "-"; %>
      <% const abertura = p.execucao_data_prevista || p.created_at || "-"; %>
      <% const fechamento = p.execucao_data_executada || "-"; %>
      <article class="preventiva-card">
        <div class="preventiva-top">
          <div>
            <div class="preventiva-code">PREV #<%= p.id %></div>
            <a class="preventiva-id" href="/preventivas/<%= p.id %>">#<%= p.id %></a>
          </div>
          <span class="pill pill-big <%= statusClass %>"><%= statusLabel %></span>
        </div>

        <h3 class="preventiva-title"><%= p.titulo || "-" %></h3>
        <div class="preventiva-equip"><%= equipamentoLabel %></div>
        <div class="preventiva-exec">
          <strong>Executores:</strong> <%= p.execucao_responsavel || "-" %>
        </div>
        <div class="preventiva-dates">
          Abertura: <%= abertura %> • Fechamento: <%= fechamento %>
        </div>

        <div class="preventiva-meta">
          <span class="pill pill-big pill-info">PREVENTIVA</span>
          <span class="pill pill-big pill-gray"><%= (p.frequencia_tipo || "-").toUpperCase() %> x<%= p.frequencia_valor || 1 %></span>
          <% if (Number(p.ativo) === 1 || p.ativo === true) { %>
            <span class="pill pill-big pill-green">PLANO ATIVO</span>
          <% } else { %>
            <span class="pill pill-big pill-gray">PLANO INATIVO</span>
          <% } %>
          <a class="btn-sm" href="/preventivas/<%= p.id %>">Abrir</a>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="preventiva-list">
    <% if (!lista || !lista.length) { %>
      <div class="preventiva-card" style="text-align:center; color:#6b7280;">
        Nenhuma preventiva cadastrada.
      </div>
    <% } %>

    <% (lista || []).forEach(p => { %>
      <article class="preventiva-card">
        <div class="preventiva-head">
          <a class="preventiva-id" href="/preventivas/<%= p.id %>">#<%= p.id %></a>
          <% if (Number(p.ativo) === 1 || p.ativo === true) { %>
            <span class="pill pill-green">ATIVA</span>
          <% } else { %>
            <span class="pill pill-gray">INATIVA</span>
          <% } %>
        </div>

        <h3 class="preventiva-title"><%= p.titulo || "-" %></h3>
        <div class="preventiva-equip">
          <%= p.equipamento_nome
                ? (p.equipamento_codigo
                    ? (p.equipamento_codigo + " • " + p.equipamento_nome)
                    : p.equipamento_nome)
                : "-" %>
        </div>

        <div class="preventiva-meta">
          <span class="pill pill-blue"><%= (p.frequencia_tipo || "-").toUpperCase() %></span>
          <span class="pill pill-gray">x<%= p.frequencia_valor || 1 %></span>
          <a class="btn-sm" href="/preventivas/<%= p.id %>">Abrir</a>
        </div>
      </article>
    <% }) %>
  </div>
</div>
