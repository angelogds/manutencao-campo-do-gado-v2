<% layout('layout') %>

<style>
  .tv-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    grid-template-areas:
      "os andamento"
      "preventivas escala"
      "mural quick"
      "demandas quick";
    gap: 10px;
    align-items: start;
  }

  .dash-col {
    display:flex;
    flex-direction:column;
    gap:16px;
    min-width:0;
  }

  .dash-col .dashboard-card {
    height:auto;
    min-height:unset;
  }

  .dashboard-card { background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:12px; box-shadow:0 1px 2px rgba(15,23,42,.04); }
  .dashboard-title { font-size:13px; font-weight:900; letter-spacing:.04em; color:#475569; text-transform:uppercase; margin-bottom:10px; }

  .kpi-grid { display:grid; grid-template-columns:repeat(3,minmax(120px,1fr)); gap:8px; margin-bottom:10px; }
  .kpi-grid.two { grid-template-columns:repeat(2,minmax(120px,1fr)); margin-bottom:0; }
  .kpi-box { border:1px solid #e5e7eb; border-radius:10px; padding:8px 10px; background:#fafafa; }
  .kpi-label { font-size:12px; color:#64748b; }
  .kpi-value { margin-top:2px; font-size:26px; font-weight:900; line-height:1.1; color:#0f172a; }

  .table-wrap { overflow:auto; }
  .table.compact th, .table.compact td { padding:8px; vertical-align:middle; font-size:13px; }
  .table.compact thead th { background:#f8fafc; }
  .muted-xs { font-size:12px; color:#64748b; }
  .list-tight { margin:8px 0 0 16px; padding:0; }

  .pagination { display:flex; justify-content:space-between; align-items:center; margin-top:10px; gap:8px; flex-wrap:wrap; }
  .btn-outline { border:1px solid #d1d5db; border-radius:9px; padding:6px 10px; background:#fff; color:#0f172a; text-decoration:none; font-weight:700; font-size:12px; }
  .btn-inline { border:none; border-radius:8px; padding:5px 9px; background:#16a34a; color:#fff; font-weight:800; cursor:pointer; font-size:12px; }
  .aviso-item { border:1px solid #e5e7eb; border-radius:10px; padding:9px 10px; background:#fff; margin-top:8px; }
  .quick-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }

  .alerta-tv { border:2px solid #dc2626; border-radius:14px; background:#fff1f2; color:#7f1d1d; padding:14px; margin-bottom:10px; display:flex; gap:14px; align-items:center; justify-content:space-between; }
  .alerta-tv.hidden { display:none; }
  .alerta-tv__title { font-size:28px; font-weight:900; letter-spacing:.02em; }
  .alerta-tv__meta { font-size:16px; font-weight:700; }
  .alerta-tv.piscar { animation: alertaPulse 1s infinite; }
  @keyframes alertaPulse { 0%{box-shadow:0 0 0 0 rgba(220,38,38,.45);} 70%{box-shadow:0 0 0 14px rgba(220,38,38,0);} 100%{box-shadow:0 0 0 0 rgba(220,38,38,0);} }
  .pill-prioridade { padding:3px 8px; border-radius:999px; font-size:11px; font-weight:800; border:1px solid #d1d5db; }
  .pill-status {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:114px;
    min-height:30px;
    text-align:center;
    font-weight:800;
    white-space:nowrap;
  }
  .pill-prioridade.emergencial { background:#fee2e2; color:#991b1b; border-color:#fca5a5; }
  .pill-prioridade.alta { background:#ffedd5; color:#9a3412; border-color:#fdba74; }
  .os-row-critico { background:#fef2f2; border-left:4px solid #dc2626; }
  .os-row-medio { background:#fffbeb; border-left:4px solid #f59e0b; }
  .os-row-leve { background:#f8fafc; }

  /* Modo TV: apresentação em tela cheia sem reescrever os cards operacionais. */
  .tv-page-head { align-items:center; gap:18px; }
  .tv-page-head__copy { flex:1; min-width:0; }
  .tv-page-head__aside { display:flex; align-items:center; justify-content:flex-end; gap:8px; flex-wrap:wrap; }
  .btn-tv-mode { background:#0f172a; color:#fff; border-color:#0f172a; }
  .btn-tv-mode:hover { background:#1e293b; }

  .modo-tv-stage {
    display:none;
    position:fixed;
    inset:0;
    z-index:99999;
    background:
      radial-gradient(circle at 18% 18%, rgba(220,38,38,.18), transparent 30%),
      radial-gradient(circle at 82% 82%, rgba(30,41,59,.55), transparent 38%),
      #070b12;
    color:#fff;
    overflow:hidden;
  }
  .modo-tv-stage.is-active { display:flex; align-items:center; justify-content:center; }
  body.tv-alerta-ativo .modo-tv-stage.is-active { display:none; }

  .modo-tv-close {
    position:absolute;
    top:18px;
    right:20px;
    z-index:4;
    border:1px solid rgba(255,255,255,.2);
    border-radius:10px;
    padding:8px 12px;
    background:rgba(15,23,42,.78);
    color:#fff;
    font-weight:800;
    cursor:pointer;
  }

  .modo-tv-brand {
    position:absolute;
    left:30px;
    top:24px;
    z-index:3;
    display:flex;
    flex-direction:column;
    gap:3px;
    pointer-events:none;
  }
  .modo-tv-brand strong { font-size:22px; letter-spacing:.04em; }
  .modo-tv-brand span { color:#cbd5e1; font-size:13px; letter-spacing:.08em; text-transform:uppercase; }

  .modo-tv-progress {
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    height:5px;
    background:rgba(255,255,255,.08);
    overflow:hidden;
    z-index:4;
  }
  .modo-tv-progress > span {
    display:block;
    width:0;
    height:100%;
    background:#dc2626;
  }

  .modo-tv-panel {
    display:none;
    width:100%;
    height:100%;
    align-items:center;
    justify-content:center;
    padding:76px 3vw 34px;
    box-sizing:border-box;
  }
  .modo-tv-panel.is-visible { display:flex; }

  .modo-tv-video-card {
    position:relative;
    width:min(88vw, 1380px);
    max-height:78vh;
    aspect-ratio:16/9;
    border-radius:24px;
    overflow:hidden;
    background:#111827;
    border:1px solid rgba(255,255,255,.14);
    box-shadow:0 28px 80px rgba(0,0,0,.48);
  }
  .modo-tv-video-card video {
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    background:#111827;
  }
  .modo-tv-video-copy {
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    padding:34px 38px 30px;
    background:linear-gradient(transparent, rgba(3,7,18,.88));
    color:#fff;
    pointer-events:none;
  }
  .modo-tv-video-copy strong { display:block; font-size:clamp(28px,3vw,48px); letter-spacing:.03em; }
  .modo-tv-video-copy span { display:block; margin-top:7px; color:#e2e8f0; font-size:clamp(14px,1.25vw,21px); }

  .modo-tv-screen {
    width:min(95vw, 1680px);
    height:calc(100vh - 112px);
    display:flex;
    flex-direction:column;
    gap:12px;
    min-height:0;
  }
  .modo-tv-screen-head {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
    flex:0 0 auto;
  }
  .modo-tv-screen-title {
    font-size:clamp(22px,2.1vw,34px);
    font-weight:900;
    letter-spacing:.02em;
  }
  .modo-tv-screen-meta {
    color:#cbd5e1;
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:.08em;
  }
  .modo-tv-screen-mount {
    flex:1;
    min-height:0;
    overflow:hidden;
    background:#f8fafc;
    border:1px solid rgba(255,255,255,.14);
    border-radius:20px;
    padding:18px;
    box-shadow:0 28px 80px rgba(0,0,0,.38);
    color:#0f172a;
  }
  .modo-tv-screen-mount > .dash-col {
    width:100%;
    transform-origin:top left;
    pointer-events:none;
  }
  .modo-tv-screen-mount a { color:inherit; text-decoration:none; }
  .modo-tv-screen-mount form,
  .modo-tv-screen-mount button { display:none !important; }
  .modo-tv-screen-mount .dashboard-card { box-shadow:none; }
  .modo-tv-screen-mount .table-wrap { overflow:hidden; }

  @media (max-width: 900px) {
    .tv-page-head { flex-direction:column; align-items:stretch; }
    .tv-page-head__aside { justify-content:flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .modo-tv-progress > span { transition:none !important; }
  }

  @media (max-width: 1200px) {
    .tv-grid { grid-template-columns: 1fr; grid-template-areas: "os" "andamento" "preventivas" "escala" "mural" "quick" "demandas"; }
    .alerta-tv__title { font-size:22px; }
  }

  @media (max-width: 760px) {
    .dash-grid { grid-template-columns: 1fr !important; }
    .dash-col { gap: 16px; }
    .kpi-grid, .kpi-grid.two, .quick-grid { grid-template-columns:1fr; }
    .alerta-tv { flex-direction:column; align-items:flex-start; }
    .alerta-tv__title { font-size:20px; }
  }
</style>

<%
  var safeDemandasResumo = demandasResumo || {};
  var demandasEmTrabalho = safeDemandasResumo.em_trabalho || [];
  var safeOSResumo = osResumo || {};
  var safeOSPainel = osPainel || {};
  var osItems = safeOSPainel.items || [];
  var osAndamento = osEmAndamento || [];
  var safeAvisos = avisos || [];
  var safeEscala = escala || {};
  var escalaDiurno = (safeEscala.diurno_mecanicos || []).map(function(p) { return p.nome; }).join(', ');
  var escalaApoio = (safeEscala.apoio_operacional || []).map(function(p) { return p.nome; }).join(', ');
  var escalaNoturno = (safeEscala.noturno || []).map(function(p) { return p.nome; }).join(', ');
  var escalaFolgasAfastamentos = safeEscala.folgas_afastamentos || [];
  var safeMotoresResumo = motoresResumo || {};
  var alertaInicial = alertaAtivo || null;
%>

<div class="page-head tv-page-head">
  <div class="tv-page-head__copy">
    <h1>Painel Operacional Reciclagem</h1>
    <p class="muted">TV da manutenção • OS, mural, preventivas, escala e demandas em tempo real</p>
    <p class="muted-xs" style="margin-top:6px; max-width:720px;">No iPhone (Safari, Edge e Chrome), os alertas push funcionam pelo app instalado na Tela de Início (abra no Safari → Compartilhar → Adicionar à Tela de Início).</p>
  </div>
  <div class="tv-page-head__aside">
    <button id="btn-modo-tv" class="btn-outline btn-tv-mode" type="button">Modo TV</button>
    <button id="btn-ativar-push" class="btn-outline" type="button" onclick="enablePush()">Ativar alertas de OS neste dispositivo</button>
  </div>
</div>

<div id="modo-tv-stage" class="modo-tv-stage" aria-hidden="true">
  <div class="modo-tv-brand">
    <strong>MANUTENÇÃO CAMPO DO GADO</strong>
    <span>Sistema Industrial • Modo TV</span>
  </div>
  <button id="btn-sair-modo-tv" class="modo-tv-close" type="button">Sair do Modo TV</button>

  <section id="modo-tv-video-panel" class="modo-tv-panel">
    <div class="modo-tv-video-card">
      <video id="modo-tv-video" muted playsinline preload="auto"></video>
      <div class="modo-tv-video-copy">
        <strong id="modo-tv-video-title">Manutenção Campo do Gado</strong>
        <span id="modo-tv-video-subtitle">Segurança, confiabilidade e disponibilidade para a operação.</span>
      </div>
    </div>
  </section>

  <section id="modo-tv-screen-panel" class="modo-tv-panel">
    <div class="modo-tv-screen">
      <div class="modo-tv-screen-head">
        <div>
          <div id="modo-tv-screen-title" class="modo-tv-screen-title">Painel Operacional</div>
          <div id="modo-tv-screen-meta" class="modo-tv-screen-meta">Dados em tempo real</div>
        </div>
      </div>
      <div id="modo-tv-screen-mount" class="modo-tv-screen-mount"></div>
    </div>
  </section>

  <div class="modo-tv-progress"><span id="modo-tv-progress-bar"></span></div>
</div>

<section id="alerta-tv" class="alerta-tv <%= alertaInicial ? 'piscar' : 'hidden' %>">
  <div>
    <div class="alerta-tv__title">⚠ NOVA OS EMERGENCIAL</div>
    <div class="alerta-tv__meta" id="alerta-tv-meta">
      <% if (alertaInicial) { %>
        Equipamento: <%= alertaInicial.equipamento || '-' %> • Setor: <%= alertaInicial.setor || '-' %> • Grau: <%= alertaInicial.grau || alertaInicial.prioridade || '-' %>
      <% } else { %>
        Nenhum alerta crítico no momento.
      <% } %>
    </div>
  </div>
  <div>
    <button id="btn-reconhecer-alerta" class="btn-inline" style="background:#dc2626;">Reconhecer alerta</button>
  </div>
</section>


<div class="dash-grid">
  <div class="dash-col">
<section class="dashboard-card area-os">
    <div class="dashboard-title">Ordem de Serviço</div>
    <div class="kpi-grid">
      <div class="kpi-box"><div class="kpi-label">Abertas</div><div class="kpi-value"><%= safeOSResumo.abertas || 0 %></div></div>
      <div class="kpi-box"><div class="kpi-label">Em andamento</div><div class="kpi-value"><%= safeOSResumo.andamento || 0 %></div></div>
      <div class="kpi-box"><div class="kpi-label">Fechadas</div><div class="kpi-value"><%= safeOSResumo.fechadas || 0 %></div></div>
    </div>
    <div class="table-wrap">
      <table class="table compact">
        <thead><tr><th>#</th><th>Equipamento</th><th>Grau</th><th>Status</th><th>Abertura</th><th>Fechamento</th><th style="text-align:right;">Ações</th></tr></thead>
        <tbody>
          <% if (osItems.length === 0) { %><tr><td colspan="7" style="text-align:center; color:#6b7280;">Nenhuma OS aberta ou em andamento.</td></tr><% } %>
          <% osItems.forEach(function(o) { var prio = String(o.grau || o.prioridade || 'MEDIA').toUpperCase(); var rowClass = (prio === 'CRITICO' || prio === 'CRÍTICO' || prio === 'ALTO' || prio === 'EMERGENCIAL') ? 'os-row-critico' : ((prio === 'MEDIO' || prio === 'MÉDIO' || prio === 'MEDIA') ? 'os-row-medio' : 'os-row-leve'); %>
            <tr class="<%= rowClass %>">
              <td><%= o.id %></td>
              <td><strong><%= o.equipamento || '-' %></strong></td>
              <td><span class="pill-prioridade <%= (prio === 'CRITICO' || prio === 'CRÍTICO' || prio === 'EMERGENCIAL') ? 'emergencial' : ((prio === 'ALTO' || prio === 'ALTA' || prio === 'MEDIO' || prio === 'MÉDIO' || prio === 'MEDIA') ? 'alta' : '') %>"><%= prio %></span></td>
              <td>
                <% var statusOs = String(o.status || '').toUpperCase(); %>
                <% if (statusOs === 'ABERTA') { %><span class="pill-tag pill-amber pill-status">Aberta</span>
                <% } else if (statusOs === 'ANDAMENTO' || statusOs === 'EM_ANDAMENTO') { %><span class="pill-tag pill-blue pill-status">Em andamento</span>
                <% } else if (statusOs === 'PAUSADA') { %><span class="pill-tag pill-gray pill-status">Pausada</span>
                <% } else if (statusOs === 'CONCLUIDA' || statusOs === 'FINALIZADA' || statusOs === 'FECHADA') { %><span class="pill-tag pill-green pill-status">Fechada</span>
                <% } else if (statusOs === 'CANCELADA') { %><span class="pill-tag pill-gray pill-status">Cancelada</span>
                <% } else { %><span class="pill-tag pill-gray pill-status"><%= statusOs || '-' %></span><% } %>
              </td>
              <td><%= o.opened_at ? fmtBR(o.opened_at) : '-' %></td>
              <td><%= o.closed_at ? fmtBR(o.closed_at) : '-' %></td>
              <td style="text-align:right;">
                <% if (statusOs === 'ABERTA') { %>
                  <form method="POST" action="/os/<%= o.id %>/status" style="display:inline;"><input type="hidden" name="status" value="ANDAMENTO"><button class="btn-inline" type="submit">Iniciar</button></form>
                <% } else { %><a class="btn-outline" href="/os/<%= o.id %>">Ver</a><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="pagination">
      <div class="muted-xs">Mostrando <strong><%= osItems.length || 0 %></strong> OS ativas (limite de <strong><%= safeOSPainel.pageSize || 15 %></strong> no painel). Fechadas ficam apenas no histórico do equipamento.</div>
    </div>
  </section>

<section class="dashboard-card area-preventivas">
    <div class="dashboard-title">Preventivas Programadas</div>
    <% if (!preventivas || preventivas.length === 0) { %><p class="muted" style="margin:0;">Nenhuma preventiva pendente.</p><% } else { %>
      <div class="table-wrap"><table class="table compact"><thead><tr><th>Equipamento</th><th>Resp.</th><th>Data</th><th>Status</th><th>Obs</th></tr></thead><tbody>
      <% preventivas.forEach(function(p) { %><tr><td><strong><%= p.equipamento_nome || '-' %></strong></td><td><%= p.responsavel || '-' %></td><td><%= p.data_prevista || '-' %></td><td><span class="pill-tag pill-gray"><%= p.status || '-' %></span></td><td><%= p.observacao || '-' %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </section>

<section class="dashboard-card area-demandas">
    <div class="dashboard-title">Demandas</div>
    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
      <span class="pill-tag pill-blue">Novas: <%= safeDemandasResumo.novas || 0 %></span>
      <span class="pill-tag pill-amber">Em andamento: <%= safeDemandasResumo.em_andamento || 0 %></span>
      <span class="pill-tag pill-gray">Paradas: <%= safeDemandasResumo.paradas || 0 %></span>
    </div>
    <ul class="list-tight">
      <% if (demandasEmTrabalho.length === 0) { %><li class="muted-xs">Nenhuma demanda em andamento.</li><% } %>
      <% demandasEmTrabalho.slice(0, 4).forEach(function(d) { %><li><a href="/demandas/<%= d.id %>">#<%= d.id %> - <%= d.titulo %></a></li><% }) %>
    </ul>
  </section>
  </div>

  <div class="dash-col">
<section class="dashboard-card area-andamento">
    <div class="dashboard-title">OS em andamento (equipe)</div>
    <div class="table-wrap"><table class="table compact">
      <thead><tr><th>OS</th><th>Equipamento</th><th>Equipe</th><th>Status</th></tr></thead>
      <tbody>
        <% if (osAndamento.length === 0) { %><tr><td colspan="4" class="muted-xs">Nenhuma OS atribuída à equipe no momento.</td></tr><% } %>
        <% osAndamento.forEach(function(o){ %>
          <tr>
            <td><a href="/os/<%= o.id %>">#<%= o.id %></a></td>
            <td><%= o.equipamento || '-' %></td>
            <td><%= o.equipe || '-' %></td>
            <td>
              <% if ((o.status || '').toUpperCase() === 'ABERTA') { %>
                <span class="pill-tag pill-amber">ABERTA</span>
              <% } else if ((o.status || '').toUpperCase() === 'ANDAMENTO' || (o.status || '').toUpperCase() === 'EM_ANDAMENTO') { %>
                <span class="pill-tag pill-blue">ANDAMENTO</span>
              <% } else { %>
                <span class="pill-tag pill-gray"><%= o.status || '-' %></span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  </section>

<section class="dashboard-card area-escala">
    <div class="dashboard-title">Escala da Semana</div>
    <% if (escalaDiurno || escalaApoio || escalaNoturno || escalaFolgasAfastamentos.length) { %>
      <div class="muted-xs" style="margin-bottom:8px;">Semana #<%= safeEscala.semana_numero || '-' %> • <%= safeEscala.data_inicio || '-' %> até <%= safeEscala.data_fim || '-' %></div>
      <table class="table compact"><tbody>
        <tr><td><strong>Dia (mecânicos)</strong></td><td><%= escalaDiurno || '-' %></td></tr>
        <tr><td><strong>Apoio operacional</strong></td><td><%= escalaApoio || '-' %></td></tr>
        <tr><td><strong>Noite (responsável)</strong></td><td><%= escalaNoturno || '-' %></td></tr>
      </tbody></table>

      <div class="dashboard-title" style="margin-top:10px; margin-bottom:6px; font-size:11px;">Folga / atestado</div>
      <% if (escalaFolgasAfastamentos.length === 0) { %>
        <p class="muted-xs" style="margin:0;">Sem mecânicos em folga/atestado nesta semana.</p>
      <% } else { %>
        <ul class="list-tight" style="margin-top:0;">
          <% escalaFolgasAfastamentos.forEach(function(item) { %>
            <li>
              <strong><%= item.nome || '-' %></strong>
              — <%= item.tipo || '-' %>
              <% if (item.data_inicio || item.data_fim) { %>
                (<%= item.data_inicio || '-' %> até <%= item.data_fim || '-' %>)
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    <% } else { %><p class="muted" style="margin:0;">Escala não disponível.</p><% } %>
  </section>

<section class="area-quick">
    <div class="dashboard-card"><div class="dashboard-title">Motores</div><div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;"><span class="pill-tag pill-green">Funcionando: <%= safeMotoresResumo.em_funcionamento || 0 %></span><span class="pill-tag pill-blue">Estoque: <%= safeMotoresResumo.em_estoque || 0 %></span><span class="pill-tag pill-amber">Conserto: <%= safeMotoresResumo.em_conserto || 0 %></span></div></div>
  </section>
  </div>
</div>

<script>
(function(){
  var eventSource = new EventSource('/dashboard/alertas/stream');
  var box = document.getElementById('alerta-tv');
  var meta = document.getElementById('alerta-tv-meta');
  var btnReconhecer = document.getElementById('btn-reconhecer-alerta');
  var alertaAtual = <%- JSON.stringify(alertaInicial || null) %>;

  if (alertaAtual && (alertaAtual.id_os || alertaAtual.os_id)) {
    document.body.classList.add('tv-alerta-ativo');
  }

  function renderAlerta(payload){
    if (!payload || !payload.id_os) {
      document.body.classList.remove('tv-alerta-ativo');
      box.classList.add('hidden');
      box.classList.remove('piscar');
      meta.textContent = 'Nenhum alerta crítico no momento.';
      return;
    }
    alertaAtual = payload;
    document.body.classList.add('tv-alerta-ativo');
    box.classList.remove('hidden');
    box.classList.add('piscar');
    meta.textContent = 'Equipamento: ' + (payload.equipamento || '-') + ' • Setor: ' + (payload.setor || '-') + ' • Grau: ' + (payload.grau || payload.prioridade || '-') + ' • OS #' + payload.id_os;
  }

  eventSource.addEventListener('estado_inicial', function(e){
    try {
      var data = JSON.parse(e.data || '{}');
      if (data.alertaAtivo) renderAlerta({
        id_os: data.alertaAtivo.os_id,
        equipamento: data.alertaAtivo.equipamento,
        setor: data.alertaAtivo.setor,
        prioridade: data.alertaAtivo.prioridade,
        grau: data.alertaAtivo.grau,
      });
    } catch(_e){}
  });

  eventSource.addEventListener('os_criada', function(){
    setTimeout(function(){ window.location.reload(); }, 900);
  });

  eventSource.addEventListener('nova_os_emergencial', function(e){
    var data = JSON.parse(e.data || '{}');
    renderAlerta(data);
    setTimeout(function(){ window.location.reload(); }, 1800);
  });

  eventSource.addEventListener('os_status_alterado', function(){
    setTimeout(function(){ window.location.reload(); }, 1200);
  });



  btnReconhecer?.addEventListener('click', function(){
    if (!alertaAtual || !alertaAtual.id_os) return;
    fetch('/dashboard/alertas/reconhecer', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ os_id: alertaAtual.id_os })
    }).then(function(){
      document.body.classList.remove('tv-alerta-ativo');
      box.classList.remove('piscar');
      box.classList.add('hidden');
      setTimeout(function(){ window.location.reload(); }, 500);
    }).catch(function(){});
  });
})();
</script>

<script>
(function(){
  var stage = document.getElementById('modo-tv-stage');
  var btnStart = document.getElementById('btn-modo-tv');
  var btnExit = document.getElementById('btn-sair-modo-tv');
  var videoPanel = document.getElementById('modo-tv-video-panel');
  var screenPanel = document.getElementById('modo-tv-screen-panel');
  var video = document.getElementById('modo-tv-video');
  var videoTitle = document.getElementById('modo-tv-video-title');
  var videoSubtitle = document.getElementById('modo-tv-video-subtitle');
  var screenTitle = document.getElementById('modo-tv-screen-title');
  var screenMeta = document.getElementById('modo-tv-screen-meta');
  var screenMount = document.getElementById('modo-tv-screen-mount');
  var progressBar = document.getElementById('modo-tv-progress-bar');

  if (!stage || !btnStart || !video || !screenMount) return;

  var dashboardColumns = Array.from(document.querySelectorAll('.dash-grid > .dash-col'));
  var screenDurationMs = 18000;
  var fallbackVideoMs = 10000;
  var running = false;
  var stepIndex = 0;
  var timer = null;
  var fallbackTimer = null;

  var sequence = [
    {
      type:'video',
      src:'/media/mascote/mascote-tv-01.mp4',
      title:'Manutenção Campo do Gado',
      subtitle:'Gestão industrial com segurança, organização e resposta rápida.'
    },
    {
      type:'screen',
      column:0,
      title:'Tela 1 • Operação e Planejamento',
      meta:'Ordens de Serviço • Preventivas • Demandas'
    },
    {
      type:'screen',
      column:1,
      title:'Tela 2 • Equipe e Disponibilidade',
      meta:'OS em andamento • Escala • Motores'
    },
    {
      type:'video',
      src:'/media/mascote/mascote-tv-02.mp4',
      title:'Manutenção Campo do Gado',
      subtitle:'Cuidando dos ativos para manter a fábrica disponível.'
    }
  ];

  function clearTimers(){
    if (timer) window.clearTimeout(timer);
    if (fallbackTimer) window.clearTimeout(fallbackTimer);
    timer = null;
    fallbackTimer = null;
  }

  function setProgress(duration){
    progressBar.style.transition = 'none';
    progressBar.style.width = '0%';
    window.requestAnimationFrame(function(){
      window.requestAnimationFrame(function(){
        progressBar.style.transition = 'width ' + duration + 'ms linear';
        progressBar.style.width = '100%';
      });
    });
  }

  function sanitizeClone(node){
    var clone = node.cloneNode(true);
    clone.querySelectorAll('[id]').forEach(function(el){ el.removeAttribute('id'); });
    clone.querySelectorAll('a').forEach(function(el){ el.removeAttribute('href'); });
    clone.querySelectorAll('form, button, input, select, textarea').forEach(function(el){
      el.setAttribute('tabindex','-1');
    });
    clone.classList.add('modo-tv-screen-clone');
    return clone;
  }

  function fitCurrentScreen(){
    var clone = screenMount.firstElementChild;
    if (!clone) return;
    clone.style.transform = '';
    clone.style.width = '100%';

    window.requestAnimationFrame(function(){
      var availableH = screenMount.clientHeight - 4;
      var availableW = screenMount.clientWidth - 4;
      var neededH = clone.scrollHeight || availableH;
      var neededW = clone.scrollWidth || availableW;
      var scale = Math.min(1, availableH / neededH, availableW / neededW);
      if (Number.isFinite(scale) && scale > 0 && scale < 1) {
        clone.style.width = (100 / scale) + '%';
        clone.style.transform = 'scale(' + scale + ')';
      }
    });
  }

  function showVideo(step){
    screenPanel.classList.remove('is-visible');
    videoPanel.classList.add('is-visible');
    screenMount.innerHTML = '';

    videoTitle.textContent = step.title;
    videoSubtitle.textContent = step.subtitle;
    video.src = step.src;
    video.muted = true;
    video.defaultMuted = true;
    video.load();

    setProgress(fallbackVideoMs);
    fallbackTimer = window.setTimeout(nextStep, fallbackVideoMs);

    var attempt = video.play();
    if (attempt && typeof attempt.catch === 'function') {
      attempt.catch(function(){
        /* fallbackTimer mantém a sequência mesmo se autoplay for bloqueado */
      });
    }
  }

  function showScreen(step){
    video.pause();
    video.removeAttribute('src');
    video.load();
    videoPanel.classList.remove('is-visible');
    screenPanel.classList.add('is-visible');

    screenTitle.textContent = step.title;
    screenMeta.textContent = step.meta;
    screenMount.innerHTML = '';

    var source = dashboardColumns[step.column];
    if (source) {
      screenMount.appendChild(sanitizeClone(source));
      fitCurrentScreen();
    }

    setProgress(screenDurationMs);
    timer = window.setTimeout(nextStep, screenDurationMs);
  }

  function renderStep(){
    if (!running) return;
    clearTimers();
    var step = sequence[stepIndex];
    if (!step) {
      stepIndex = 0;
      step = sequence[0];
    }

    if (step.type === 'video') showVideo(step);
    else showScreen(step);
  }

  function nextStep(){
    if (!running) return;
    clearTimers();
    stepIndex = (stepIndex + 1) % sequence.length;
    renderStep();
  }

  function startModoTv(){
    if (running) return;
    running = true;
    stepIndex = 0;
    stage.classList.add('is-active');
    stage.setAttribute('aria-hidden','false');
    document.body.classList.add('modo-tv-ativo');

    var url = new URL(window.location.href);
    url.searchParams.set('modo','tv');
    window.history.replaceState({},'',url.toString());

    if (document.documentElement.requestFullscreen && !document.fullscreenElement) {
      var full = document.documentElement.requestFullscreen();
      if (full && typeof full.catch === 'function') full.catch(function(){});
    }

    renderStep();
  }

  function stopModoTv(){
    if (!running) return;
    running = false;
    clearTimers();
    video.pause();
    stage.classList.remove('is-active');
    stage.setAttribute('aria-hidden','true');
    document.body.classList.remove('modo-tv-ativo');
    screenMount.innerHTML = '';
    progressBar.style.transition = 'none';
    progressBar.style.width = '0%';

    var url = new URL(window.location.href);
    url.searchParams.delete('modo');
    window.history.replaceState({},'',url.pathname + url.search + url.hash);

    if (document.fullscreenElement && document.exitFullscreen) {
      var exit = document.exitFullscreen();
      if (exit && typeof exit.catch === 'function') exit.catch(function(){});
    }
  }

  video.addEventListener('ended', function(){
    if (running && sequence[stepIndex] && sequence[stepIndex].type === 'video') nextStep();
  });
  video.addEventListener('error', function(){
    if (running && sequence[stepIndex] && sequence[stepIndex].type === 'video') {
      clearTimers();
      timer = window.setTimeout(nextStep, 1200);
    }
  });

  btnStart.addEventListener('click', startModoTv);
  btnExit.addEventListener('click', stopModoTv);
  window.addEventListener('resize', fitCurrentScreen);
  document.addEventListener('keydown', function(event){
    if (event.key === 'Escape' && running) stopModoTv();
  });

  if (new URL(window.location.href).searchParams.get('modo') === 'tv') {
    startModoTv();
  }
})();
</script>
