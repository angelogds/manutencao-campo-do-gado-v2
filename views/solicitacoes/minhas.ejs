<h1>Minhas Solicitações</h1>
<div class="cards-grid">
  <% Object.entries(counters || {}).forEach(([k,v])=> { %><div class="card"><strong><%= k %></strong><div><%= v %></div></div><% }) %>
</div>
<a class="btn" href="/solicitacoes/nova">Nova solicitação</a>
<table class="table"><tr><th>Número</th><th>Título</th><th>Status</th><th>Criada</th></tr>
<% lista.forEach(s => { %><tr><td><a href="/solicitacoes/<%= s.id %>"><%= s.numero %></a></td><td><%= s.titulo %></td><td><span class="badge"><%= s.status %></span></td><td><%= fmtBR(s.created_at) %></td></tr><% }) %>
</table>
