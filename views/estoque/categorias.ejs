<% layout('layout') %>
<div class="page-head">
  <div>
    <h1>Categorias de Estoque</h1>
    <p class="muted">Organize os itens por famílias e subfamílias.</p>
  </div>
</div>
<%- include('_tabs', { tab: 'categorias' }) %>

<div class="grid-2">
  <div class="card">
    <div class="label">Nova categoria</div>
    <form method="POST" action="/estoque/categorias">
      <input class="input" name="nome" placeholder="Nome da categoria" required />
      <button class="btn btn-green" style="margin-top:10px;">Criar categoria</button>
    </form>
  </div>
  <div class="card">
    <div class="label">Categorias ativas</div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>ID</th><th>Nome</th><th>Criada em</th></tr></thead>
        <tbody>
          <% if (!categorias.length) { %><tr><td colspan="3" class="muted">Sem categorias cadastradas.</td></tr><% } %>
          <% categorias.forEach((categoria) => { %><tr><td><%= categoria.id %></td><td><%= categoria.nome %></td><td><%= fmtBR(categoria.created_at) %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
