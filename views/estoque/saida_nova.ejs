<h1>Registrar Saída</h1>
<form method="POST" action="/estoque/saidas">
<select name="item_id"><% itens.forEach(i=> { %><option value="<%= i.id %>"><%= i.nome %> (saldo: <%= i.saldo_atual %>)</option><% }) %></select>
<input type="number" step="0.01" name="quantidade" placeholder="Quantidade" required/>
<input name="observacao" placeholder="Observação"/>
<input name="referencia_id" placeholder="ID referência"/>
<button>Registrar</button>
</form>
